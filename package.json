    "@tailwindcss/vite": "^4.3.2",
    "@vercel/og": "^0.11.1",
    "astro": "^7.0.9",
    "astro-expressive-code": "^0.44.0",
    "astro-pagefind": "^2.0.1",
    "clsx": "^2.1.1",
    "github-slugger": "^2.0.0",
    "mermaid": "^11.16.0",
    "motion": "^12.16.0",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.34.5",
