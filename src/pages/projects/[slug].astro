---
import { getCollection, render } from 'astro:content';
import { ExternalLink } from '@lucide/astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import Callout from '@/components/mdx/Callout.astro';
import Tabs from '@/components/mdx/Tabs.astro';
import Tab from '@/components/mdx/Tab.astro';
import Accordion from '@/components/mdx/Accordion.astro';
import Mermaid from '@/components/Mermaid.astro';
import { projects } from '@/data/site';
import { slugifyProjectName } from '@/lib/slug';

export async function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: slugifyProjectName(project.name) },
    props: { project },
  }));
}

type Props = { project: (typeof projects)[number] };
const { project } = Astro.props;
const slug = slugifyProjectName(project.name);

const writeups = await getCollection('projectWriteups');
const writeupEntry = writeups.find((entry) => entry.data.project === project.name);
const writeup = writeupEntry ? await render(writeupEntry) : null;

const liveUrl = 'liveUrl' in project && typeof project.liveUrl === 'string' ? project.liveUrl : null;
const githubUrl = 'githubUrl' in project && typeof project.githubUrl === 'string' ? project.githubUrl : null;
const ogImageUrl = new URL(`/projects/${slug}/og.png`, Astro.site);
const canonicalUrl = new URL(`/projects/${slug}`, Astro.site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: project.name,
  description: project.description,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Web',
  ...(liveUrl ? { url: liveUrl } : {}),
  ...(githubUrl ? { codeRepository: githubUrl } : {}),
  author: { '@type': 'Person', name: 'Janpol Hidalgo' },
  image: ogImageUrl.toString(),
  mainEntityOfPage: canonicalUrl.toString(),
};
const button =
  'press group inline-flex min-h-11 items-center gap-2 rounded-full px-5 text-sm font-semibold no-underline';
---

<BaseLayout
  title={`${project.name} | Janpol Hidalgo`}
  description={project.description}
  image={ogImageUrl.toString()}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

  <main id="main" tabindex="-1" class="shell page outline-none">
    <article>
      <PageHeader
        eyebrow={project.status === 'completed' ? 'Completed' : 'In progress'}
        title={project.name}
        lead={project.description}
        back={{ href: '/projects', label: 'All projects' }}
        transitionName={`project-${slug}`}
      >
        <ul class="mt-8 mb-0 flex list-none flex-wrap gap-2 p-0 font-mono text-xs text-muted" aria-label={`${project.name} technology stack`} data-reveal-group>
          {project.techStack.map((technology) => <li class="rounded-md border border-line px-2 py-0.5" data-reveal-item>{technology}</li>)}
        </ul>
        <div class="mt-8 flex flex-wrap gap-3" data-intro>
          {githubUrl && (
            <a class={`${button} bg-ink text-canvas hover:bg-accent hover:text-white`} href={githubUrl} rel="noreferrer">Source</a>
          )}
          {liveUrl && (
            <a class={`${button} border border-line text-ink hover:border-ink hover:bg-surface hover:text-ink`} href={liveUrl} rel="noreferrer">
              Live demo
              <ExternalLink size={14} class="transition-transform duration-[440ms] ease-bounce group-hover:translate-x-0.5 group-hover:-translate-y-0.5" aria-hidden="true" />
            </a>
          )}
          {!githubUrl && !liveUrl && <span class="meta">Private repo, in progress</span>}
        </div>
      </PageHeader>

      {writeup ? (
        <div class="prose py-20" data-reveal>
          <writeup.Content components={{ Callout, Tabs, Tab, Accordion, Mermaid }} />
        </div>
      ) : (
        <div class="py-20" data-reveal>
          <p class="max-w-[56ch] text-lg text-muted">
            {githubUrl
              ? 'A detailed write-up for this project is coming soon. In the meantime, the source and README on GitHub cover the implementation.'
              : 'A detailed write-up for this project is coming soon.'}
          </p>
        </div>
      )}
    </article>
  </main>
</BaseLayout>
