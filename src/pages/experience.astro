---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import { Briefcase, Calendar, MapPin, GraduationCap, Award, ArrowUpRight, ChevronDown } from '@lucide/astro';
import { certifications, education, experiences, projects } from '@/data/site';
import { slugifyProjectName } from '@/lib/slug';
---

<BaseLayout title="Experience | Janpol Hidalgo" description="Work history, education, and certifications.">
  <main id="main" tabindex="-1" class="shell page outline-none">
    <PageHeader eyebrow="Experience" title="Where I've worked" />

    <section class="border-b border-line py-20">
      <div class="relative" data-reveal-group>
        <!-- Rail behind the icons; the accent layer draws as you scroll. -->
        <div class="pointer-events-none absolute top-8 bottom-8 left-5 w-px bg-line-subtle max-sm:hidden" aria-hidden="true">
          <div class="timeline-progress size-full origin-top bg-accent/50"></div>
        </div>
        {experiences.map((experience) => {
          const hasDetails = experience.achievements.length > 0 || experience.techStack.length > 0 || experience.relatedProjects.length > 0;
          // Only entries with extra detail are collapsible; the rest are static.
          const Item = hasDetails ? 'details' : 'div';
          const Head = hasDetails ? 'summary' : 'div';
          return (
            <Item class="smooth group/item border-b border-line-subtle last:border-b-0" data-reveal-item>
              <Head class:list={['flex list-none gap-5 py-8 max-sm:flex-col max-sm:gap-3', hasDetails && 'cursor-pointer']}>
                <span class="relative z-10 grid size-10 flex-none place-items-center rounded-full border border-line bg-surface text-accent transition-[scale,background-color] duration-[440ms] ease-bounce group-open/item:bg-elevated group-hover/item:scale-110" aria-hidden="true">
                  <Briefcase size={16} />
                </span>
                <div class="min-w-0 flex-1">
                  <div class="flex items-start justify-between gap-4">
                    <h3 class="mb-1">{experience.title}</h3>
                    {hasDetails && (
                      <ChevronDown size={18} class="mt-1 shrink-0 text-faint transition-transform duration-[440ms] ease-spring group-open/item:rotate-180" aria-hidden="true" />
                    )}
                  </div>
                  <p class="mb-2 text-[0.9375rem] text-muted">
                    {experience.website
                      ? <a class="text-accent" href={experience.website} rel="noreferrer">{experience.company}</a>
                      : experience.company}
                  </p>
                  <p class="mb-3 flex flex-wrap gap-4 font-mono text-xs text-faint">
                    <span class="inline-flex items-center gap-1"><Calendar size={13} aria-hidden="true" />{experience.period}</span>
                    <span class="inline-flex items-center gap-1"><MapPin size={13} aria-hidden="true" />{experience.location}</span>
                  </p>
                  <p class="m-0 text-muted">{experience.description}</p>
                </div>
              </Head>
              {hasDetails && (
                <div class="mb-8 ml-[3.75rem] grid gap-4 max-sm:ml-0">
                  {experience.achievements.length > 0 && (
                    <ul class="m-0 list-none p-0 text-[0.9375rem] text-muted">
                      {experience.achievements.map((achievement) => (
                        <li class="relative mb-2 pl-5 before:absolute before:top-[0.55em] before:left-0 before:size-1.5 before:rounded-full before:bg-accent">{achievement}</li>
                      ))}
                    </ul>
                  )}
                  {experience.techStack.length > 0 && (
                    <ul class="m-0 flex list-none flex-wrap gap-2 p-0 font-mono text-xs text-muted">
                      {experience.techStack.map((technology) => <li class="rounded-md border border-line px-2 py-0.5">{technology}</li>)}
                    </ul>
                  )}
                  {experience.relatedProjects.length > 0 && (
                    <p class="m-0 flex flex-wrap gap-4">
                      {experience.relatedProjects.map((name) => {
                        const project = projects.find((candidate) => candidate.name === name);
                        return project ? (
                          <a class="group/link inline-flex items-center gap-1 text-sm text-accent" href={`/projects/${slugifyProjectName(project.name)}`}>
                            {project.name}
                            <ArrowUpRight size={13} class="transition-transform duration-[440ms] ease-bounce group-hover/link:translate-x-0.5 group-hover/link:-translate-y-0.5" aria-hidden="true" />
                          </a>
                        ) : null;
                      })}
                    </p>
                  )}
                </div>
              )}
            </Item>
          );
        })}
      </div>
    </section>

    <section class="py-20" data-reveal>
      <div class="grid gap-px overflow-hidden rounded-xl border border-line bg-line md:grid-cols-2">
        <section class="min-w-0 bg-surface p-6" aria-labelledby="education-title">
          <h3 id="education-title" class="mb-5 flex items-center gap-2 text-base"><GraduationCap size={16} aria-hidden="true" /> Education</h3>
          <div class="border-t border-line">
            {education.map((item) => (
              <article class="grid grid-cols-[6rem_minmax(0,1fr)] items-baseline gap-4 border-b border-line-subtle py-4 last:border-b-0">
                <p class="meta">{item.period}</p>
                <div>
                  <h4 class="mb-1 text-[0.9375rem] leading-snug">{item.degree}</h4>
                  <p class="m-0 text-sm text-muted">{item.institution}</p>
                  <strong class="text-[0.8125rem]">{item.status}</strong>
                </div>
              </article>
            ))}
          </div>
        </section>
        <section class="min-w-0 bg-surface p-6" aria-labelledby="certifications-title">
          <h3 id="certifications-title" class="mb-5 flex items-center gap-2 text-base"><Award size={16} aria-hidden="true" /> Certifications</h3>
          <div class="border-t border-line">
            {certifications.map((item) => (
              <article class="grid grid-cols-[6rem_minmax(0,1fr)] items-baseline gap-4 border-b border-line-subtle py-4 last:border-b-0">
                <p class="meta">{item.date}</p>
                <div>
                  <h4 class="mb-1 text-[0.9375rem] leading-snug">
                    <a class="decoration-line hover:decoration-current" href={item.link} rel="noreferrer">{item.name}</a>
                  </h4>
                  <p class="m-0 text-sm text-muted">{item.issuer}</p>
                </div>
              </article>
            ))}
          </div>
        </section>
      </div>
    </section>
  </main>
</BaseLayout>
