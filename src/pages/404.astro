---
import { ArrowRight } from '@lucide/astro';
import BaseLayout from '@/layouts/BaseLayout.astro';

const suggestions = [
  { href: '/', label: 'Home', hint: 'Who I am and what I do' },
  { href: '/projects', label: 'Projects', hint: 'Things I have built' },
  { href: '/notes', label: 'Notes', hint: 'Things I have learned' },
];
---

<BaseLayout title="Not found | Janpol Hidalgo">
  <main id="main" tabindex="-1" class="shell page outline-none">
    <header class="page-header border-b border-line pb-16">
      <!-- Digits drop in on a bouncy spring: a rare page, so it gets a moment. -->
      <p class="m-0 flex font-mono text-[clamp(5rem,22vw,10rem)] leading-none font-medium tracking-[-0.06em] text-line select-none" aria-hidden="true">
        {['4', '0', '4'].map((digit) => <span class="inline-block" data-digit>{digit}</span>)}
      </p>
      <p class="meta mt-6" data-intro>404</p>
      <h1 class="mt-3" data-intro>Page not found</h1>
      <p class="mb-0 max-w-[56ch] text-lg text-muted" data-intro>This route does not exist. The home page has the current map.</p>
    </header>
    <nav aria-label="Suggested pages" class="border-b border-line" data-reveal-group>
      {suggestions.map((item) => (
        <a
          href={item.href}
          class="group flex items-center justify-between gap-4 border-t border-line-subtle py-5 no-underline first:border-t-0 hover:text-ink"
          data-reveal-item
          data-glow
        >
          <span>
            <span class="block text-lg font-medium transition-colors duration-200 group-hover:text-accent-hover">{item.label}</span>
            <span class="text-sm text-muted">{item.hint}</span>
          </span>
          <ArrowRight size={18} class="text-faint transition-[translate,color] duration-[440ms] ease-bounce group-hover:translate-x-1 group-hover:text-accent" aria-hidden="true" />
        </a>
      ))}
    </nav>
  </main>
</BaseLayout>

<script>
  import { animate, stagger } from 'motion';

  document.addEventListener('astro:page-load', () => {
    const digits = document.querySelectorAll('[data-digit]');
    if (!digits.length || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    animate(
      digits,
      { transform: ['translateY(-60%) rotate(-8deg)', 'translateY(0) rotate(0deg)'], opacity: [0, 1] },
      { type: 'spring', bounce: 0.35, duration: 0.8, delay: stagger(0.09) },
    );
  });
</script>
