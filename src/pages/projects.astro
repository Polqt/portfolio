---
import PageHeader from '@/components/PageHeader.astro';
import ProjectList from '@/components/ProjectList.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Projects | Janpol Hidalgo"
  description="Web, mobile, AI, and real-time systems built by Janpol Hidalgo."
>
  <main id="main" tabindex="-1" class="shell page pb-12! outline-none">
    <PageHeader
      eyebrow="Selected work"
      title="Projects"
      lead="Building things that solve real problems, from AI pipelines to real-time collaboration tools."
    />
    <section class="pt-20">
      <ProjectList />
    </section>
  </main>
</BaseLayout>
