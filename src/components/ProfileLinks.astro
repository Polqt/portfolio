---
import { FileText, Mail } from '@lucide/astro';
import { SITE } from '@/data/site';
---

<nav class="profile-icon-links" aria-label="Profile links">
  <a href={SITE.cvPath} download="Hidalgo_CV.pdf" aria-label="Download CV" title="Download CV">
    <FileText size={20} aria-hidden="true" />
  </a>
  <a href={`mailto:${SITE.email}`} aria-label="Email Janpol" title="Email Janpol">
    <Mail size={20} aria-hidden="true" />
  </a>
  <a href={SITE.github} rel="noreferrer" aria-label="Janpol on GitHub" title="GitHub">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.75a9.25 9.25 0 0 0-2.92 18.03c.46.08.63-.2.63-.45v-1.62c-2.57.56-3.11-1.09-3.11-1.09-.42-1.07-1.03-1.35-1.03-1.35-.84-.58.06-.57.06-.57.93.07 1.42.96 1.42.96.83 1.42 2.17 1.01 2.7.77.08-.6.32-1.01.59-1.24-2.05-.23-4.2-1.03-4.2-4.57 0-1.01.36-1.84.95-2.48-.1-.24-.41-1.18.09-2.45 0 0 .78-.25 2.54.95A8.8 8.8 0 0 1 12 7.29a8.8 8.8 0 0 1 2.31.31c1.77-1.2 2.54-.95 2.54-.95.5 1.27.19 2.21.09 2.45.59.64.95 1.47.95 2.48 0 3.55-2.16 4.33-4.21 4.56.33.29.63.85.63 1.72v2.47c0 .25.17.54.63.45A9.25 9.25 0 0 0 12 2.75Z" class="icon-fill" /></svg>
  </a>
  <a href={SITE.linkedin} rel="noreferrer" aria-label="Janpol on LinkedIn" title="LinkedIn">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5.25 8.5v10.25M5.25 5.25v.01M9.75 18.75V8.5m0 4.5c.6-2.75 6-3.25 6 1v4.75" /></svg>
  </a>
</nav>
