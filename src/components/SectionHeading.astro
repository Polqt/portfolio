---
import { ArrowRight } from '@lucide/astro';

type Props = { id: string; title: string; href?: string; linkLabel?: string };
const { id, title, href, linkLabel } = Astro.props;
---

<div class="mb-10 flex items-baseline justify-between gap-4" data-reveal>
  <h2 id={id} class="m-0 text-[clamp(1.375rem,2.4vw,1.75rem)]">{title}</h2>
  {href && (
    <a
      href={href}
      class="press group inline-flex min-h-11 shrink-0 items-center gap-1.5 font-mono text-xs tracking-[0.04em] text-accent uppercase no-underline hover:text-accent-hover"
    >
      {linkLabel}
      <ArrowRight size={14} class="transition-transform duration-[440ms] ease-bounce group-hover:translate-x-1" aria-hidden="true" />
    </a>
  )}
</div>
