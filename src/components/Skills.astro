---
import { skillCategories } from '@/data/site';
---

<div class="grid gap-5" data-reveal-group>
  {skillCategories.map(({ category, skills }) => (
    <div class="grid gap-4 border-b border-line-subtle pb-5 last:border-b-0 sm:grid-cols-[8rem_1fr] sm:items-baseline sm:gap-6" data-reveal-item>
      <h3 class="meta text-xs! font-normal">{category}</h3>
      <ul class="m-0 flex list-none flex-wrap gap-2 p-0">
        {skills.map((skill) => (
          <li class="press rounded-full border border-line px-3 py-1 text-sm whitespace-nowrap text-muted hover:-translate-y-0.5 hover:border-ink hover:text-ink">
            {skill}
          </li>
        ))}
      </ul>
    </div>
  ))}
</div>
