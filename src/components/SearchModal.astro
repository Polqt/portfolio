---
import PagefindSearch from 'astro-pagefind/components/Search.astro';
---

<button id="search-trigger" type="button" class="search-trigger" aria-haspopup="dialog" aria-controls="search-modal">
  <svg width="15" height="15" viewBox="0 0 15 15" fill="none" aria-hidden="true">
    <path d="M6.5 11a4.5 4.5 0 1 0 0-9 4.5 4.5 0 0 0 0 9ZM13 13l-2.9-2.9" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
  </svg>
  <span>Search</span>
  <kbd><span>Ctrl</span>K</kbd>
</button>

<dialog id="search-modal" class="search-modal" aria-label="Search notes and projects" data-pagefind-ignore data-pf-theme="light">
  <div class="search-modal-inner">
    <PagefindSearch
      className="pagefind-search"
      searchboxOptions={{ maxResults: 8, placeholder: 'Search notes and projects…', showSubResults: true, autofocus: true }}
    />
    <p class="search-modal-hint"><kbd>Esc</kbd> to close</p>
  </div>
</dialog>

<script>
  const trigger = document.querySelector('#search-trigger');
  const modal = document.querySelector('#search-modal');

  const syncPfTheme = () => {
    if (!(modal instanceof HTMLDialogElement)) return;
    const root = document.documentElement;
    const dark = root.dataset.theme === 'dark' ||
      (!root.dataset.theme && matchMedia('(prefers-color-scheme: dark)').matches);
    modal.dataset.pfTheme = dark ? 'dark' : 'light';
  };
  syncPfTheme();
  window.addEventListener('portfolio:theme-change', syncPfTheme);

  const openModal = () => {
    if (!(modal instanceof HTMLDialogElement) || modal.open) return;
    modal.showModal();
    modal.querySelector<HTMLInputElement>('input[type="text"]')?.focus();
  };

  const closeModal = () => {
    if (modal instanceof HTMLDialogElement && modal.open) modal.close();
  };

  trigger?.addEventListener('click', openModal);

  modal?.addEventListener('click', (event) => {
    if (event.target === modal) closeModal();
  });

  document.addEventListener('keydown', (event) => {
    const isK = event.key === 'k' || event.key === 'K';
    if ((event.metaKey || event.ctrlKey) && isK) {
      event.preventDefault();
      if (modal instanceof HTMLDialogElement && modal.open) closeModal();
      else openModal();
    }
  });
</script>
