---
import { SITE } from '@/data/site';
import { ClientRouter } from 'astro:transitions';
import '@/styles/global.css';

type Props = {
  description?: string;
  image?: string;
  title?: string;
};

const {
  description = 'Software engineer crafting modern web and mobile experiences.',
  image,
  title = 'Janpol Hidalgo - Developer',
} = Astro.props;
const ogImage = image ?? new URL('/WebAvatar.png', Astro.site).toString();
const path = Astro.url.pathname;
const links = [
  { href: '/', label: 'Home' },
  { href: '/projects', label: 'Projects' },
  { href: '/notes', label: 'Notes' },
];
const isActive = (href: string) => !href.includes('#') && (href === '/' ? path === href : path.startsWith(href));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F7F7F3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#10100F" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/WebAvatar.png" />
    <link rel="alternate" type="application/rss+xml" title="Janpol Hidalgo - Notes" href="/rss.xml" />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:image" content={ogImage} />
    <title>{title}</title>
    <ClientRouter />
    <script is:inline>
      const saved = localStorage.getItem('theme');
      if (saved === 'dark') document.documentElement.dataset.theme = 'dark';
      if (saved === 'light') document.documentElement.dataset.theme = 'light';
      // Flag JS + motion-allowed BEFORE first paint so reveal/header items can
      // start hidden without a flash. No-JS or reduced-motion users never get
      // the hidden state, keeping content visible as a progressive enhancement.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('js-anim');
      }
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a class="wordmark" href="/" aria-label="Janpol Hidalgo home" data-header-item>Jepoy<span class="wordmark-dot">.</span></a>
        <nav aria-label="Primary navigation">
          {links.map((link) => (
            <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined} data-header-item>
              {link.label}
            </a>
          ))}
        </nav>
        <div class="header-actions">
          <a href={SITE.cvPath} download="Hidalgo_CV.pdf" data-header-item>CV</a>
          <button id="theme-toggle" type="button" aria-label="Use dark theme" aria-pressed="false" data-header-item>Theme</button>
        </div>
      </div>
    </header>

    <slot />

    <footer class="site-footer">
      <div class="footer-inner">
        <p>{SITE.name}</p>
        <div>
          <a href="/experience">Experience</a>
          <a href="/uses">Uses</a>
          <a href={`mailto:${SITE.email}`}>Email</a>
          <a href={SITE.github} rel="noreferrer">GitHub</a>
          <a href={SITE.linkedin} rel="noreferrer">LinkedIn</a>
        </div>
      </div>
    </footer>

    <script>
      import { animate, inView, stagger } from 'motion';

      const root = document.documentElement;
      const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
      const isDarkTheme = () => root.dataset.theme === 'dark' ||
        (!root.dataset.theme && matchMedia('(prefers-color-scheme: dark)').matches);

      const syncGiscusTheme = () => {
        const frame = document.querySelector('iframe.giscus-frame');
        if (!(frame instanceof HTMLIFrameElement)) return;
        frame.contentWindow?.postMessage(
          { giscus: { setConfig: { theme: isDarkTheme() ? 'dark' : 'light' } } },
          'https://giscus.app',
        );
      };

      // Theme toggle is re-bound each page load because ClientRouter swaps the
      // DOM, replacing the old button. Fresh query + fresh listener each time,
      // so no stale handlers and no double-binding.
      const bindTheme = () => {
        const themeToggle = document.querySelector('#theme-toggle');
        const syncToggle = () => {
          if (!(themeToggle instanceof HTMLButtonElement)) return;
          const dark = isDarkTheme();
          themeToggle.setAttribute('aria-pressed', String(dark));
          themeToggle.setAttribute('aria-label', dark ? 'Use light theme' : 'Use dark theme');
          syncGiscusTheme();
        };
        syncToggle();
        themeToggle?.addEventListener('click', () => {
          root.dataset.theme = isDarkTheme() ? 'light' : 'dark';
          localStorage.setItem('theme', root.dataset.theme);
          syncToggle();
          window.dispatchEvent(new CustomEvent('portfolio:theme-change'));
        });
      };

      // Giscus loads async and only exists on note pages; observe once, sync
      // theme when its iframe appears, then disconnect.
      const watchGiscus = () => {
        const observer = new MutationObserver(() => {
          syncGiscusTheme();
          if (document.querySelector('iframe.giscus-frame')) observer.disconnect();
        });
        observer.observe(document.body, { childList: true, subtree: true });
      };

      const runAnimations = () => {
        if (reduceMotion.matches) return;

        // Header entrance: stagger wordmark, nav links, actions in. Transform +
        // opacity only, stays on the compositor.
        const headerItems = document.querySelectorAll('[data-header-item]');
        if (headerItems.length) {
          animate(
            headerItems,
            { opacity: [0, 1], transform: ['translateY(-8px)', 'translateY(0)'] },
            { duration: 0.45, delay: stagger(0.05), ease: [0.16, 1, 0.3, 1] },
          );
        }

        // Scroll reveal: soft rise + brief blur-in for depth. blur is cheap
        // here (small text/card blocks) and runs once per element on enter.
        inView('[data-reveal]', (element) => {
          const delayMs = element instanceof HTMLElement
            ? Number.parseFloat(getComputedStyle(element).getPropertyValue('--reveal-delay')) || 0
            : 0;
          animate(
            element,
            {
              opacity: [0, 1],
              transform: ['translateY(18px) scale(0.985)', 'translateY(0) scale(1)'],
              filter: ['blur(6px)', 'blur(0px)'],
            },
            { duration: 0.6, delay: delayMs / 1000, ease: [0.16, 1, 0.3, 1] },
          );
        }, { amount: 0.15 });
      };

      // Cursor-follow glow: one delegated pointer listener for the whole page,
      // survives DOM swaps and never leaks per-card handlers. Writes two CSS
      // custom props the card reads for a radial highlight; skipped on coarse
      // (touch) pointers where there's no hover.
      const bindCardGlow = () => {
        if (matchMedia('(pointer: coarse)').matches || reduceMotion.matches) return;
        document.addEventListener('pointermove', (event) => {
          const target = event.target;
          if (!(target instanceof Element)) return;
          const card = target.closest('[data-glow]');
          if (!(card instanceof HTMLElement)) return;
          const rect = card.getBoundingClientRect();
          card.style.setProperty('--glow-x', `${event.clientX - rect.left}px`);
          card.style.setProperty('--glow-y', `${event.clientY - rect.top}px`);
        }, { passive: true });
      };

      // Page-level bindings (delegated / global) run once for the session.
      watchGiscus();
      bindCardGlow();

      // Per-page setup: astro:page-load fires on the initial load AND after
      // every ClientRouter navigation, so binding only here avoids a
      // double-run on first paint while still refreshing the swapped DOM.
      document.addEventListener('astro:page-load', () => {
        bindTheme();
        runAnimations();
      });
    </script>
  </body>
</html>
